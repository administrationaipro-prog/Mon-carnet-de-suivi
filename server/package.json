{
  "name": "server",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json && cp src/schema.sql dist/schema.sql",
    "start": "node dist/index.js",
    "migrate": "tsx src/migrate.ts",
    "seed:demo": "tsx src/seedDemo.ts",
    "seed:demo:prod": "node dist/seedDemo.js",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.14.0",
    "cookie-parser": "^1.4.7",
    "express": "^5.3.0",
    "helmet": "^8.3.0",
    "pdf-lib": "^1.17.1",
    "pg": "^8.23.1",
    "qrcode": "^1.5.4",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.6",
    "@types/pg": "^8.23.1",
    "@types/qrcode": "^1.5.6",
    "@types/supertest": "^7.2.1",
    "supertest": "^7.3.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.1.1"
  }
}
